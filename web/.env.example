# Copy to .env.local for development. On Vercel, set these in Project Settings -> Environment Variables.
# Supabase: Project Settings -> API Keys. Use the publishable key (read-only through RLS).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
