# Copy to .env and fill in. Never commit .env.

# Postgres connection string. `npx supabase link` saves it (without the password) in
# supabase/.temp/pooler-url. Use this Session pooler URL: it works over IPv4, which GitHub Actions needs.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Lake storage (first match wins):
#  1. Supabase Storage REST API: project URL + legacy service_role key (a JWT), from
#     `npx supabase projects api-keys --project-ref <project-ref>`
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
LAKE_BUCKET=lake
#  2. Any S3-compatible store (set LAKE_S3_ENDPOINT to use this instead), e.g. Supabase Storage's
#     S3 endpoint with access keys from Project Settings -> Storage -> S3 Connection.
# LAKE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# LAKE_S3_REGION=<region>
# LAKE_S3_ACCESS_KEY_ID=
# LAKE_S3_SECRET_ACCESS_KEY=
#  3. Neither set: Parquet files go to ./data/lake

# Optional tuning
# MAX_COLLECT_SECONDS=480
# INITIAL_LOOKBACK_MINUTES=15
# BRONZE_RETENTION_DAYS=3
# SILVER_RETENTION_DAYS=14
# PAGE_ACTIVITY_RETENTION_DAYS=3
